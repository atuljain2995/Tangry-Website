# Copy to `.env.local` and fill in values. Never commit real secrets.

# Neon Postgres (required for DB, newsletter, checkout) — use the pooled connection string
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Signs COD email OTPs and the verified-email cookie (required in production)
# COD_OTP_SECRET=

# Product image uploads: Supabase Storage (public bucket "product-images")
# SUPABASE_STORAGE_URL=https://YOUR_REF.supabase.co
# SUPABASE_STORAGE_KEY=

# Optional: Cloudflare R2 (used instead of Supabase Storage when all are set)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Only for `npm run export-db` from another Postgres (e.g. the old Supabase DB)
# SOURCE_DATABASE_URL=

# Marketplace “Buy online” — optional. If unset, Flipkart opens a search for “tangry spices”.
# NEXT_PUBLIC_TANGRY_FLIPKART_URL=https://www.flipkart.com/...

# Public Instagram profile URL (optional). Defaults to https://www.instagram.com/tangryspices
# Set this to your live brand handle before launch if it differs.
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/yourhandle

# Google Analytics 4 Measurement ID (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Vercel deploy hook for admin-triggered rebuild requests (server-only)
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/PROJECT_ID/HOOK_ID

# Cooldown for rebuild button (seconds). Clamped between 30 and 60.
# ADMIN_REBUILD_COOLDOWN_SECONDS=45
