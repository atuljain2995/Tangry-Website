# Payload CMS Environment Variables
# Add these to your .env.local file

# Required: A random secret for Payload auth tokens (min 32 chars)
PAYLOAD_SECRET=your-random-secret-at-least-32-characters-long

# Database: Can reuse your existing DATABASE_URL or set a separate one
# Payload will create its own tables (payload_*, blog_posts, recipes, media, authors, users)
PAYLOAD_DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Or if you prefer to reuse the existing one, just ensure DATABASE_URL is set

# S3 Storage (for media uploads) — reuses your existing AWS/S3 config
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=ap-south-1
# S3_ENDPOINT=https://your-custom-endpoint.com  # Only if using R2/MinIO/etc.
